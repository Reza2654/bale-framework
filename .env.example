# ==========================================
# ExBaleBot - Website Health & Uptime Monitor
# ==========================================

# Your Bale Bot Token from @BotFather on Bale Messenger
BALE_BOT_TOKEN=your_bale_bot_token_here

# Bale API Base URL
BALE_BASE_URL=https://tapi.bale.ai

# SuperAdmin User ID in Bale (for /setplan command)
ADMIN_USER_ID=1234567890

# Database File Paths
DB_PATH=data/monitor.db

# Background Scheduler Interval (seconds between monitor cycles)
SCHEDULER_INTERVAL_SECS=30

# Ingestion Worker Threads/Coroutines
WORKERS_COUNT=8

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
